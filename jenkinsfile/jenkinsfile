
pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '732231074792'
        ECR_REPOSITORY = 'mega_project01'
        DOCKER_IMAGE = '732231074792.dkr.ecr.ap-south-1.amazonaws.com/mega_project01'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Dhanushrajan123/Megaproject.git',
                    credentialsId: 'github-creds'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} .
                '''
            }
        }

        stage('Login to AWS ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} |
                    docker login --username AWS --password-stdin \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('Update GitOps Manifest') {
            steps {
                withCredentials([gitUsernamePassword(
                    credentialsId: 'github-creds',
                    gitToolName: 'Default'
                )]) {
                    sh '''
                        # Manifest update will be finalized after
                        # verifying the current deployment.yaml.

                        git config user.name "Jenkins"
                        git config user.email "jenkins@localhost"

                        git add k8s-files/deployment.yaml

                        if ! git diff --cached --quiet; then
                            git commit -m "Update GoCart image to ${IMAGE_TAG} [skip ci]"
                            git push origin HEAD:dhanush
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'GoCart image pushed to ECR successfully!'
        }

        failure {
            echo 'Pipeline failed. Check console output.'
        }

        always {
            sh '''
                docker logout ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com || true
            '''
        }
    }
}
